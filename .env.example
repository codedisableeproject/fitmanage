# Kosongkan / hapus baris ini selama backend belum siap —
# server/api/*.ts otomatis pakai dummy data (lihat server/utils/dummyData.ts).
BACKEND_BASE_URL=

# Google OAuth — isi untuk aktifkan login Google beneran (redirect asli
# ke accounts.google.com). Cara dapetin: Google Cloud Console > APIs &
# Services > Credentials > Create OAuth client ID (Web application).
# Authorized redirect URI yang HARUS didaftarkan di sana:
#   http://localhost:3000/auth/google-callback   (development)
#   https://domain-kamu.com/auth/google-callback  (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tombol "Masuk sebagai Super Admin (Dev)" di halaman login. Default:
# otomatis mati saat production build (NODE_ENV=production). Set eksplisit
# "true"/"false" di sini kalau mau override.
ALLOW_DEV_LOGIN=
